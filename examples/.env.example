# Copy this file to `.env` in the same folder as compose.yml and fill it in.
# Keep `.env` private – it holds secrets. Never commit it anywhere.

# ---- Microsoft sign-in (optional) ---------------------------------------------
# Local accounts work without these. You can also set them on the dashboard's
# Settings page instead (the secret is then stored encrypted). Anything set here
# wins over the Settings page and shows as locked there.
# Overview → Directory (tenant) ID – the long code, not your domain name.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Overview → Application (client) ID.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Certificates & secrets → the secret's *Value*
# AZURE_CLIENT_SECRET=paste-the-client-secret-value-here

# ---- Email notifications (optional) --------------------------------------------
# You can leave these out and add notification channels (Azure Communication
# Services, SMTP2GO or SMTP) on the dashboard's Settings page instead. These three
# make a read-only "Email (from environment)" channel that carries the weekly digest.
# Azure Communication Services → Keys → Connection string.
# ACS_CONNECTION_STRING=
# A MailFrom address of the Communication Services domain.
# DIGEST_FROM=DoNotReply@example.com
# Who gets the digest, comma-separated.
# DIGEST_TO=you@example.com
