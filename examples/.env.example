# Copy this file to `.env` in the same folder as compose.yml and fill it in.
# Keep `.env` private – it holds secrets. Never commit it anywhere.

# Entra app registration → Certificates & secrets → the secret's *Value*
AZURE_CLIENT_SECRET=paste-the-client-secret-value-here

# A long random string used to sign the sign-in cookie. Create one with:
#   openssl rand -hex 32
SESSION_SECRET=paste-a-long-random-string-here

# Azure Communication Services → Keys → Connection string.
# Leave empty to switch the weekly email off.
ACS_CONNECTION_STRING=
