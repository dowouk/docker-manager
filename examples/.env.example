# Copy this file to `.env` in the same folder as compose.yml and fill it in.
# Keep `.env` private – it holds secrets. Never commit it anywhere.

# ---- Entra app registration ------------------------------------------------
# Overview → Directory (tenant) ID – the long code, not your domain name.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Overview → Application (client) ID.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Certificates & secrets → the secret's *Value*
AZURE_CLIENT_SECRET=paste-the-client-secret-value-here

# A long random string used to sign the sign-in cookie. Create one with:
#   openssl rand -hex 32
SESSION_SECRET=paste-a-long-random-string-here

# ---- Weekly email ------------------------------------------------------------
# Azure Communication Services → Keys → Connection string.
# Leave empty to switch the weekly email off.
ACS_CONNECTION_STRING=
# A MailFrom address of the Communication Services domain.
DIGEST_FROM=DoNotReply@example.com
# Who gets the email, comma-separated.
DIGEST_TO=you@example.com
